generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model StoreItem {
  id    Int    @id @default(autoincrement())
  title String
  image String
  price String

  @@map("store_items")
}

model TourDate {
  id      Int     @id @default(autoincrement())
  date    String
  venue   String
  city    String
  link    String
  vip     Boolean @default(false)
  tickets Boolean @default(true)

  @@map("tour_dates")
}

model BreadGood {
  id    Int    @id @default(autoincrement())
  title String
  image String
  price String
  link  String

  @@map("bread_goods")
}

